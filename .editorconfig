# EditorConfig ayuda a los desarrolladores a definir y mantener consistencia en el estilo de código
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Frontend (React/TypeScript) y Archivos Web
[*.{js,jsx,ts,tsx,css,json,html,md,yml,yaml}]
indent_style = space
indent_size = 2

# Backend (Java/Spring Boot)
[*.java]
indent_style = space
indent_size = 4

# Configuracion de Maven y recursos del backend
[*.{xml,properties}]
indent_style = space
indent_size = 2

# En Markdown, dos espacios finales significan salto de linea: no se recortan
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
