# =========================================================================
# VARIABLES DE ENTORNO DE MOICA (PLANTILLA)
# =========================================================================
# Copia este archivo como `.env` en la raiz del repositorio y ajusta los
# valores. `.env` esta en `.gitignore` y NUNCA debe subirse.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# Los valores de abajo son para DESARROLLO LOCAL. No sirven para produccion:
# alli cada variable se define en el entorno del servidor, nunca en un archivo
# versionado.
#
# Quien lee cada variable:
#   - docker-compose.yml  las toma automaticamente de `.env`.
#   - El backend las lee del entorno y, si no estan, importa este mismo `.env`
#     mediante `spring.config.import` (ver backend/src/main/resources/
#     application.properties).

# -------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL
# -------------------------------------------------------------------------
# Nombre de la base de datos que crea el contenedor y que usa el backend.
MOICA_DB_NOMBRE=moica_db

# Usuario y contrasena de la base de datos local.
# Cambia la contrasena si compartes la maquina; solo aplica a tu entorno.
MOICA_DB_USUARIO=moica_dev
MOICA_DB_CLAVE=clave_local_de_desarrollo

# Host y puerto por los que el backend alcanza PostgreSQL.
# `localhost` es correcto cuando el backend corre fuera de Docker.
#
# MOICA_DB_PORT es el puerto por el que el contenedor publica la base hacia tu
# maquina; dentro del contenedor siempre es 5432. Si ya tienes un PostgreSQL
# instalado ocupando el 5432, cambia este valor (por ejemplo a 5433) y no hace
# falta tocar nada mas: el backend se conecta por la misma variable.
MOICA_DB_HOST=localhost
MOICA_DB_PORT=5432

# -------------------------------------------------------------------------
# PGADMIN (HERRAMIENTA OPCIONAL DE DESARROLLO)
# -------------------------------------------------------------------------
# Credenciales con las que se entra a la interfaz web de pgAdmin.
MOICA_PGADMIN_EMAIL=dev@moica.local
MOICA_PGADMIN_CLAVE=clave_local_de_pgadmin
MOICA_PGADMIN_PORT=5050

# -------------------------------------------------------------------------
# BACKEND
# -------------------------------------------------------------------------
# Puerto donde escucha Spring Boot. El proxy de Vite apunta aqui.
MOICA_BACKEND_PORT=8080

# -------------------------------------------------------------------------
# AUTENTICACION Y SESIONES
# -------------------------------------------------------------------------
# Clave con la que se firma el JWT de sesion. Necesita al menos 32 bytes
# (HMAC-SHA256): con menos, la aplicacion no arranca.
#
# EL VALOR DE ABAJO ES PUBLICO Y SOLO SIRVE PARA DESARROLLO LOCAL. En cualquier
# entorno compartido o de produccion se define en el entorno del servidor con un
# valor aleatorio y distinto, que nunca se versiona. Para generar uno:
#
#   Linux / macOS:       openssl rand -base64 48
#   Windows PowerShell:  $b = [byte[]]::new(48); [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
MOICA_JWT_SECRETO=secreto_local_de_desarrollo_cambialo_en_produccion

# Cuanto dura una sesion, en formato ISO-8601 de duraciones. Por omision P7D
# (siete dias). Moica no renueva sesiones: al expirar se vuelve a iniciar sesion.
MOICA_SESION_DURACION=P7D

# `Secure` en las cookies que emite Moica. En desarrollo va en `false` porque el
# proxy de Vite trabaja sobre HTTP; en produccion siempre `true`.
MOICA_COOKIE_SEGURA=false

# -------------------------------------------------------------------------
# SEGUNDO FACTOR (TOTP)
# -------------------------------------------------------------------------
# Clave con la que se cifra el secreto TOTP de cada cuenta antes de guardarlo
# (AES-GCM). Va en Base64 y debe decodificar a 16, 24 o 32 bytes; con cualquier
# otra cosa la aplicacion no arranca.
#
# EL VALOR DE ABAJO ES PUBLICO Y SOLO SIRVE PARA DESARROLLO LOCAL. En cualquier
# entorno compartido o de produccion se define en el entorno del servidor con un
# valor aleatorio y distinto, que nunca se versiona. Para generar uno:
#
#   Linux / macOS:       openssl rand -base64 32
#   Windows PowerShell:  $b = [byte[]]::new(32); [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#
# Cambiar esta clave deja ilegibles los secretos ya guardados: quien tuviera el
# segundo factor activo tendria que volver a configurarlo.
MOICA_TOTP_CLAVE_CIFRADO=Y2xhdmUtcHVibGljYS1kZS1kZXNhcnJvbGxvLW1vaWM=

# -------------------------------------------------------------------------
# ALMACENAMIENTO DE IMAGENES PUBLICAS (CLOUDFLARE R2)
# -------------------------------------------------------------------------
# Conexion con el bucket publico de imagenes de perfil y portafolio, mediante
# la compatibilidad S3 de R2. Las cinco variables van juntas: o se definen
# todas o no se define ninguna. Sin ellas la aplicacion arranca igualmente,
# pero subir o borrar imagenes responde `ALMACENAMIENTO_NO_DISPONIBLE`.
#
# Como obtener cada valor y como aprovisionar el bucket con un token limitado:
# Docs/Dev/Almacenamiento.md.
#
# LOS SECRETOS VAN VACIOS A PROPOSITO: cada quien pega los suyos en su `.env`
# local y en produccion se definen en el entorno del servidor. NUNCA se
# versionan.

# Identificador de la cuenta de Cloudflare (forma parte del endpoint S3).
MOICA_R2_ID_CUENTA=

# Credenciales del token de API con permisos de lectura y escritura de objetos
# SOLO sobre el bucket publico.
MOICA_R2_ACCESS_KEY_ID=
MOICA_R2_SECRET_ACCESS_KEY=

# Nombre del bucket publico ya aprovisionado (por ejemplo, moica-publico-dev).
MOICA_R2_BUCKET_PUBLICO=

# Origen HTTPS desde el que los navegadores leen las imagenes. En desarrollo
# es el subdominio r2.dev del bucket (https://pub-<hash>.r2.dev); en
# produccion sera un dominio propio. Sin barra final.
MOICA_R2_URL_PUBLICA_BASE=

# Tamano maximo por imagen. Formato de Spring (5MB, 8MB, 512KB...).
MOICA_IMAGEN_TAMANO_MAXIMO=5MB

# -------------------------------------------------------------------------
# ALMACENAMIENTO PRIVADO DE EXPEDIENTES (CLOUDFLARE R2)
# -------------------------------------------------------------------------
# Conexion con el bucket PRIVADO donde viven los documentos de verificacion.
# Es un bucket DISTINTO del publico y usa un token DISTINTO: asi un fallo de
# configuracion en el bucket de imagenes no puede exponer un documento de
# identidad. No reutilices aqui las credenciales de arriba.
#
# Las cuatro variables van juntas: o se definen todas o no se define ninguna.
# Sin ellas la aplicacion arranca igualmente, pero enviar un expediente o abrir
# un documento responde `ALMACENAMIENTO_NO_DISPONIBLE`.
#
# Como aprovisionar el bucket privado y su token limitado:
# Docs/Dev/Almacenamiento.md.
#
# No hay URL publica que configurar: el bucket privado NO debe tener habilitado
# el subdominio r2.dev ni un dominio propio. Lo unico que sale de el es una URL
# prefirmada de vida corta que genera el backend en cada apertura autorizada.
#
# LOS SECRETOS VAN VACIOS A PROPOSITO: cada quien pega los suyos en su `.env`
# local y en produccion se definen en el entorno del servidor. NUNCA se
# versionan.

# Identificador de la cuenta de Cloudflare (forma parte del endpoint S3).
MOICA_R2_PRIVADO_ID_CUENTA=

# Credenciales del token de API con permisos de lectura y escritura de objetos
# SOLO sobre el bucket privado.
MOICA_R2_PRIVADO_ACCESS_KEY_ID=
MOICA_R2_PRIVADO_SECRET_ACCESS_KEY=

# Nombre del bucket privado ya aprovisionado (por ejemplo, moica-privado-dev).
MOICA_R2_BUCKET_PRIVADO=

# Tamano maximo por documento del expediente. Formato de Spring (5MB, 2MB...).
# Solo puede bajarse: 5MB es el tope que impone la restriccion
# ck_documento_verificacion_tamano de PostgreSQL.
MOICA_DOCUMENTO_TAMANO_MAXIMO=5MB

# Cuanto vale el enlace temporal con el que un administrador abre un documento,
# en formato ISO-8601 de duraciones. Por omision PT5M (cinco minutos). La
# aplicacion no admite mas de una hora: un acceso temporal mas largo deja de
# serlo.
MOICA_DOCUMENTO_URL_TEMPORAL_DURACION=PT5M

# -------------------------------------------------------------------------
# ROL ADMINISTRATIVO
# -------------------------------------------------------------------------
# Correo de una cuenta YA REGISTRADA que debe recibir el rol administrativo al
# arrancar. Moica no tiene registro publico de administradores ni endpoint de
# promocion: esta variable es la unica via.
#
# Como se usa:
#   1. Registra la cuenta desde la aplicacion, como cualquier otra.
#   2. Escribe aqui su correo y reinicia el backend.
#   3. Entra con esa cuenta, activa su segundo factor y ya puedes abrir /admin.
#
# Vacia o sin definir, no se promueve a nadie. Si apunta a una cuenta que no
# existe, el arranque continua y deja un aviso en el registro.
MOICA_ADMIN_CORREO=

# -------------------------------------------------------------------------
# MODERACION
# -------------------------------------------------------------------------
# Cada cuanto se comprueba si alguna medida administrativa temporal ya cumplio
# su plazo, en formato ISO-8601 de duraciones. Por omision PT1M (un minuto).
#
# El barrido no decide ninguna sancion: solo ejecuta la fecha de fin que una
# persona administradora fijo al aplicar la medida. Este periodo es, por tanto,
# el retraso maximo entre que una medida vence y la cuenta vuelve a ACTIVA.
MOICA_EXPIRACION_MEDIDAS_PERIODO=PT1M

# -------------------------------------------------------------------------
# CANAL EXTERNO DE SOPORTE
# -------------------------------------------------------------------------
# A donde escribe quien quiere apelar una medida administrativa. La apelacion se
# presenta FUERA de Moica: no hay formulario ni buzon dentro de la aplicacion.
# Lo unico que Moica hace es mostrar este canal junto al aviso de la medida, y
# despues un administrador registra en el expediente lo que recibio.
#
# No es un secreto: se publica a la persona sancionada, tanto en el aviso de su
# sesion como en el mensaje que recibe al intentar entrar con una cuenta
# suspendida. Ese mensaje es lo unico que esa persona llega a leer.
#
# El valor de abajo es un marcador de posicion del proyecto, no una direccion
# atendida. Sustituyelo por la real antes de publicar.
MOICA_SOPORTE_CANAL=soporte@moica.ni
