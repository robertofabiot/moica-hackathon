server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    # No registrar URLs de documentos, consultas ni datos de autenticacion.
    access_log off;
    # Por encima del tope multipart de Spring (25 MB): asi el rechazo por tamano
    # lo da el backend con el JSON CONTENIDO_DEMASIADO_GRANDE del contrato, y
    # Nginx solo corta como freno grueso lo que ni siquiera deberia llegar.
    client_max_body_size 30m;
    resolver ${MOICA_DNS_RESOLVER} valid=10s;
    set $backend http://${MOICA_BACKEND_UPSTREAM};
    set $moica_scheme ${MOICA_PUBLIC_SCHEME};
    set $moica_port ${MOICA_PUBLIC_PORT};
    include /etc/nginx/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location ~ ^/(api(?:/|$)|actuator/health$) {
        include /etc/nginx/proxy-headers.conf;
        # Una carga de archivos puede tardar mas que los 60 s por omision: el
        # backend espera a R2 hasta 60 s por objeto y el cliente, 90 s. Si Nginx
        # cortara antes, la persona veria un 504 de un envio que si se guardo.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $backend;
    }
    location /actuator { return 404; }
    location ~ /\. { return 404; }
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
    }
    location ~* \.(?:js|css|webmanifest|png|jpg|jpeg|svg|ico|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
}
