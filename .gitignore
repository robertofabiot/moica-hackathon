# =========================================================================
# DEPENDENCIAS Y ARTEFACTOS DE COMPILACION
# =========================================================================
node_modules/
dist/
dist-ssr/
build/
target/
*.jar
*.war
*.ear
*.class

# Salida del plugin PWA de Vite (se regenera en cada build).
frontend/dev-dist/
frontend/public/sw.js
frontend/public/workbox-*.js

# =========================================================================
# MAVEN
# =========================================================================
# El wrapper (mvnw, mvnw.cmd y .mvn/wrapper/maven-wrapper.properties) SI se
# versiona: es la entrada reproducible del backend. Lo que se ignora es lo
# que el wrapper descarga o genera.
.mvn/wrapper/maven-wrapper.jar
.mvn/.gradle-enterprise/
.mvn/.develocity/
buildNumber.properties
dependency-reduced-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# =========================================================================
# PRUEBAS Y COBERTURA
# =========================================================================
coverage/
.nyc_output/
*.lcov
surefire-reports/
failsafe-reports/

# =========================================================================
# VARIABLES DE ENTORNO (NUNCA SE VERSIONAN)
# =========================================================================
# El unico archivo de entorno versionado es .env.example, sin secretos.
.env
.env.*
!.env.example

# =========================================================================
# INSTRUCCIONES LOCALES PARA ASISTENTES
# =========================================================================
# Directrices personales de desarrollo. No forman parte del producto ni
# se versionan. Cada persona las mantiene en su máquina.
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.cursor/
.claude/
.codex/

# =========================================================================
# CONFIGURACIONES DE IDEs Y EDITORES
# =========================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
nbproject/private/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================================================================
# ARCHIVOS DEL SISTEMA OPERATIVO
# =========================================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =========================================================================
# LOGS Y TEMPORALES
