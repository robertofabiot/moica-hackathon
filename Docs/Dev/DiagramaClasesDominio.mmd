flowchart TD
    %% Estilos
    classDef startEnd fill:#1B1B1B,stroke:#333,stroke-width:2px,color:#fff;
    classDef decision fill:#FFEBEE,stroke:#C62828,stroke-width:2px;
    classDef action fill:#E3F2FD,stroke:#1565C0,stroke-width:1px;

    %% Nodos de inicio y fin
    StartNode((Inicio))
    EndNode((Fin))

    %% ==========================================
    %% Carriles (Swimlanes) simulados con Subgraphs
    %% ==========================================

    subgraph Cliente [Carril: Cliente]
        direction TB
        C1[Explorar servicios y perfil del prestador]
        C2[Enviar solicitud de servicio]
        C3[Coordinar trabajo vía Chat]
        C4[Calificar al Prestador\nOpcional]
        C5[Cancelar Solicitud]
    end

    subgraph Sistema [Carril: Sistema MOICA]
        direction TB
        S1{¿Prestador Disponible\ny Servicio Activo?}
        S2[Registrar Solicitud:\nEstado PENDIENTE]
        S3[Habilitar Chat y\nContactos Externos]
        S4[Registrar Estado:\nACEPTADA]
        S5[Registrar Estado:\nCANCELADA / RECHAZADA]
        S6[Registrar Estado:\nCOMPLETADA]
        S7[Habilitar módulo\nde calificaciones]
    end

    subgraph Prestador [Carril: Prestador]
        direction TB
        P1{¿Acepta el\nservicio?}
        P2[Coordinar trabajo vía Chat]
        P3[Realizar el trabajo físico]
        P4[Marcar solicitud\ncomo Completada]
        P5[Calificar al Cliente\nOpcional]
        P6[Cancelar Solicitud\ncon motivo]
    end

    %% ==========================================
    %% Flujo de Actividades
    %% ==========================================

    StartNode --> C1
    C1 --> S1
    S1 -- "No" --> C1
    S1 -- "Sí" --> C2

    C2 --> S2
    S2 --> P1

    %% Decisión del Prestador
    P1 -- "Rechaza" --> S5
    P1 -- "Acepta" --> S4
    
    S4 --> S3
    S3 --> C3
    S3 --> P2

    %% Fase de coordinación y cancelación
    C3 <--> P2
    C3 -.->|"Decide cancelar"| C5
    P2 -.->|"Decide cancelar"| P6
    
    C5 --> S5
    P6 --> S5
    S5 --> EndNode

    %% Finalización
    P2 --> P3
    P3 --> P4
    P4 --> S6
    S6 --> S7
    
    S7 --> C4
    S7 --> P5
    
    C4 --> EndNode
    P5 --> EndNode

    %% ==========================================
    %% Asignación de Clases (Alta Compatibilidad)
    %% ==========================================
    class StartNode,EndNode startEnd;
    class C1,C2,C3,C4,C5,S2,S3,S4,S5,S6,S7,P2,P3,P4,P5,P6 action;
    class S1,P1 decision;